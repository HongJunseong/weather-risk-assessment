# Airflow
AIRFLOW_UID=1000

# 기상청 KMA API 키
KMA_API_KEY=

# AWS S3 (Data Lake)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_RISK_STREAM_BUCKET=
# 로컬 MinIO 테스트에서만 설정 (예: http://localhost:9000)
S3_ENDPOINT_URL=

# Slack (High-Risk Alert)
SLACK_WEBHOOK_URL=

# Slack alert가 읽을 risk 데이터 경로
# 기본값: s3://{S3_RISK_STREAM_BUCKET}/gold_export/risk_latest
# 로컬 파일로 override 하려면 절대 경로 입력
RISK_LATEST_PATH=

# 로컬 Python 실행용 데이터 루트 (빈 값이면 저장소/data)
# Compose에서는 /opt/airflow/data로 설정됨
WEATHER_DATA_DIR=
# 수집 출력 재정의 (컨테이너에서 접근 가능한 절대 경로)
DRE_SINK_DIR=
